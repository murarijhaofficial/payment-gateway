# Comma-separated browser origins permitted to call read-only API routes.
# In production, configure this explicitly; CORS otherwise denies all origins.
CORS_ORIGINS=https://merchant.example.com
APP_ENV=development
PORT=3001
# Local sandbox database only. Replace the placeholder credentials locally.
DATABASE_URL=postgresql://sandbox_user:replace_me@127.0.0.1:5432/gateway_sandbox
