# Comma-separated browser origins permitted to call API routes.
# In production, configure this explicitly; CORS otherwise denies all origins.
CORS_ORIGINS=https://merchant.example.com
APP_ENV=development
PORT=3001
# Dedicated sandbox database. Replace the placeholder credentials locally.
DATABASE_URL=postgresql://sandbox_user:replace_me@127.0.0.1:5432/gateway_sandbox
# Enable after applying the workspace migration and generating private keys.
ENABLE_SANDBOX_WORKSPACE=false
# Generate using scripts/prepare-workspace.mjs; never commit the actual key.
SANDBOX_ENCRYPTION_KEY=
# See docs/WORKSPACE_SETUP.md for private seed passwords and administrator MFA.
